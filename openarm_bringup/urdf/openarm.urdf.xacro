<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="description_root" default="$(find openarm_description)" />
  <xacro:arg name="robot_preset" default="v2/default_bimanual" />
  <xacro:arg name="use_fake_hardware" default="true" />
  <xacro:arg name="hardware_config" default="" />
  <xacro:arg name="mujoco_command_interface" default="position" />
  <xacro:arg name="left_can_interface" default="can1" />
  <xacro:arg name="right_can_interface" default="can0" />
  <xacro:arg name="can_fd" default="true" />
  <xacro:include filename="$(arg description_root)/assets/common/robot.xacro" />
  <xacro:property name="backend_file" value="$(arg hardware_config)" />
  <xacro:property name="backend" value="${xacro.load_yaml(backend_file) if backend_file else dict()}" />
  <xacro:property name="mode" value="$(arg mujoco_command_interface)" />
  <xacro:property name="interfaces" value="${['position'] if mode == 'position' else ['position', 'velocity', 'effort']}" />
  <xacro:property name="overrides" value="${dict([(name, dict(values, command_interface=mode, command_interfaces=interfaces)) for name, values in backend.items()])}" />
  <xacro:openarm_robot robot_preset="$(arg robot_preset)" ros2_control="true"
    use_fake_hardware="$(arg use_fake_hardware)" hardware_overrides="${overrides}"
    left_can_interface="$(arg left_can_interface)" right_can_interface="$(arg right_can_interface)" can_fd="$(arg can_fd)" />
  <xacro:attribute name="name" value="${robot_name}" />
</robot>
